DATABASE_URL=sqlite:///data/processed/gigbid.db
CHECKPOINT_URL=data/processed/checkpoints.db
MARKETPLACE_MODE=mock
# open = hosted open-weight models on Groq (needs GROQ_API_KEY); open_local = Ollama on this machine.
MODEL_PROFILE=open
GROQ_API_KEY=
# Read-only GitHub token for importing repositories through GitHub's MCP server.
GITHUB_TOKEN=
# Key that encrypts stored OAuth tokens. Generate one with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Where Upwork returns after sign-in; Upwork accepts only callback addresses it has approved.
UPWORK_REDIRECT_URI=http://localhost:3000/api/integrations/upwork/callback
RETRIEVAL_VARIANT=
OLLAMA_URL=http://127.0.0.1:11434
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_MODE=local
QDRANT_PATH=data/processed/qdrant
QUEUE_MODE=database
MCP_TRANSPORT=stdio
MCP_BIND_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
MCP_SERVER_TIMEOUT_SECONDS=20
MCP_RETRY_MAX_DELAY_SECONDS=2
PORTFOLIO_MCP_URL=http://localhost:8001/mcp
MARKETPLACE_MCP_URL=http://localhost:8002/mcp
WORKSPACE_MCP_URL=http://localhost:8003/mcp
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MODEL_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
MCP_CALLS_PER_MINUTE=60
MAX_UPLOAD_BYTES=2000000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
# Compose foundation only. Set a URL-safe password in the shell before starting.
POSTGRES_PASSWORD=
