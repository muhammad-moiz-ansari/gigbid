---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	classify(classify)
	draft(draft)
	verifier(verifier)
	compliance(compliance)
	preview(preview)
	regenerate(regenerate)
	approval(approval)
	execute(execute)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	approval -.-> __end__;
	approval -.-> execute;
	approval -.-> regenerate;
	approval -.-> verifier;
	classify -.-> __end__;
	classify -.-> draft;
	compliance -.-> __end__;
	compliance -.-> preview;
	draft --> verifier;
	intake --> classify;
	preview --> approval;
	regenerate --> verifier;
	verifier --> compliance;
	execute --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
