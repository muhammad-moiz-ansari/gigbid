---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__(<p>__start__</p>)
	intake(intake)
	analyst(analyst)
	risk(risk)
	matcher(matcher)
	reconcile(reconcile)
	pricing(pricing)
	writer(writer)
	verifier(verifier)
	critic(critic)
	compliance(compliance)
	preview(preview)
	execute(execute)
	approval(approval)
	__end__(<p>__end__</p>)
	__start__ --> intake;
	analyst --> reconcile;
	intake -.-> analyst;
	intake -.-> matcher;
	intake -.-> risk;
	matcher --> reconcile;
	risk --> reconcile;
	reconcile --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
